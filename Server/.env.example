# ── Server ──────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────
MONGO_URI=mongodb://localhost:27017/gaunleswad?replicaSet=rs0

# ── JWT ─────────────────────────────────
JWT_SECRET=your-jwt-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ───────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Firebase Admin SDK (Cloud Messaging / Push Notifications) ─────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Sparrow SMS ─────────────────────────
SPARROW_SMS_TOKEN=your-sparrow-token
SPARROW_SMS_FROM=GharkoSwad

# ── Cloudinary ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

KHALTI_SECRET_KEY=your-khalti-test-secret-key

# eSewa Payment
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np

# Frontend URL
WEB_URL=http://localhost:3000

# Optional admin portal URL
ADMIN_URL=http://localhost:5174
KITCHEN_OPEN_HOUR=7
KITCHEN_CLOSE_HOUR=22
